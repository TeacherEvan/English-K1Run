{
  "name": "kindergarten-race-game",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "kill": "fuser -k 5000/tcp",
    "build": "npm run audio:validate && tsc -b && vite build",
    "check-types": "tsc -b --noCheck",
    "lint": "eslint .",
    "audit:loc": "node scripts/loc-audit.cjs",
    "audit:loc:report": "node scripts/loc-audit.cjs --report-only",
    "verify": "npm run lint && npm run build",
    "audio:list-voices": "node scripts/list-elevenlabs-voices.cjs",
    "audio:list-voices:th": "node scripts/list-elevenlabs-voices.cjs --lang=th",
    "audio:validate": "node scripts/validate-audio-files.cjs",
    "audio:generate": "node scripts/generate-sentence-audio.cjs",
    "audio:generate-welcome": "node scripts/generate-missing-welcome-audio.cjs",
    "audio:generate-welcome:th": "node scripts/generate-missing-welcome-audio.cjs --lang=th --force",
    "audio:generate-welcome-hf": "node scripts/generate-welcome-audio-hf.cjs",
    "requirements": "node scripts/generate-requirements.cjs",
    "requirements:json": "node scripts/generate-requirements.cjs --format json",
    "requirements:md": "node scripts/generate-requirements.cjs --format markdown",
    "optimize": "vite optimize",
    "preview": "vite preview",
    "cap:sync": "cap sync",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:build:android": "npm run build && cap sync android",
    "cap:build:ios": "npm run build && cap sync ios",
    "install:android": "npm install",
    "install:safe": "npm install --no-optional",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:deployment": "PLAYWRIGHT_DEPLOYMENT_URL=https://english-k1-run.vercel.app playwright test e2e/specs/deployment-diagnostic.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:allure": "allure generate allure-results --clean && allure open",
    "verify:welcome-assets": "node scripts/check-welcome-build-assets.cjs",
    "dashboard:server": "node dashboard-server.js",
    "dashboard:ui": "cd dashboard-ui && npm start",
    "dashboard": "concurrently \"npm run dashboard:server\" \"npm run dashboard:ui\""
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@radix-ui/react-aspect-ratio": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.1.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dexie": "^4.2.1",
    "dexie-react-hooks": "^4.4.0",
    "express": "^5.2.1",
    "i18next": "^26.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.0.0",
    "react-i18next": "^17.0.12",
    "tailwind-merge": "^3.0.2",
    "web-vitals": "^6.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "4.1.11",
    "allure-playwright": "^3.10.2",
    "concurrently": "^10.0.4",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^17.3.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.1.11"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "overrides": {
    "serialize-javascript": ">=7.0.3"
  }
}
